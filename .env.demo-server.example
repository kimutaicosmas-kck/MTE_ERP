# MTE ERP on demo.abexcore.co.ke (same VPS as AbexCore production)
# cp .env.demo-server.example .env.demo-server
#
# Use hex passwords only (no / + @ in MYSQL_PASSWORD) so DATABASE_URL in compose stays valid.
#   openssl rand -hex 24

JWT_SECRET=CHANGE_ME_DEMO_JWT_SECRET

MYSQL_DATABASE=mte_erp
MYSQL_USER=mte
MYSQL_PASSWORD=CHANGE_ME_HEX_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_HEX_ROOT_PASSWORD
