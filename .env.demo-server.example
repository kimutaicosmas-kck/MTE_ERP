# MTE ERP on demo.abexcore.co.ke (same VPS as AbexCore production)
# cp .env.demo-server.example .env.demo-server
# openssl rand -base64 48  → JWT_SECRET

JWT_SECRET=CHANGE_ME_DEMO_JWT_SECRET

MYSQL_DATABASE=mte_erp
MYSQL_USER=mte
MYSQL_PASSWORD=CHANGE_ME_DEMO_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_DEMO_ROOT_PASSWORD

# Required — password must be URL-encoded in this URL (/ → %2F, + → %2B, @ → %40)
# Example: openssl rand -hex 24  (hex avoids encoding issues)
DATABASE_URL=mysql://mte:CHANGE_ME_DEMO_DB_PASSWORD@mysql:3306/mte_erp?connection_limit=25
